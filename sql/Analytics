CREATE VIEW Analytics.ticket_volume_by_product AS
SELECT
product_purchased,
COUNT(*) AS total_tickets
FROM tickets
GROUP BY product_purchased
ORDER BY total_tickets DESC;

SELECT * FROM analytics.ticket_volume_by_product;

CREATE VIEW analytics.avg_resolution_time AS
SELECT
ticket_type,
AVG(time_to_resolution - first_response_time) AS avg_resolution_time
FROM tickets
GROUP BY ticket_type;

SELECT * FROM analytics.avg_resolution_time;

CREATE VIEW analytics.customer_satisfaction_by_type AS
SELECT
ticket_type,
AVG(customer_satisfaction_rating) AS avg_rating
FROM tickets
GROUP BY ticket_type
ORDER BY avg_rating DESC;

select * from analytics.customer_satisfaction_by_type;

CREATE VIEW analytics.channel_performance AS
SELECT
ticket_channel,
AVG(time_to_resolution - first_response_time) AS avg_resolution_time,
AVG(customer_satisfaction_rating) AS avg_rating
FROM tickets
GROUP BY ticket_channel;

select * from analytics.channel_performance;

SELECT * FROM ticket_predictions
LIMIT 10;

SELECT predicted_ticket_type, COUNT(*)
FROM ticket_predictions
GROUP BY predicted_ticket_type;


SELECT 
t.ticket_id,
t.ticket_priority,
t.ticket_channel,
t.product_purchased,
t.customer_satisfaction_rating,
p.predicted_ticket_type
FROM tickets t
JOIN ticket_predictions p
ON t.ticket_id = p.ticket_id;

